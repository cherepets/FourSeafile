<UserControl
    x:Class="FourSeafile.Viewers.TextViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsEnabled="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <CommandBar Background="{ThemeResource SystemControlHighlightAccentBrush}">
            <CommandBar.Content>
                <TextBlock x:Name="Header" Margin="12" />
            </CommandBar.Content>
            <AppBarButton
                x:Uid="SaveButton"
                Click="Save_Click"
                Icon="Save" />
            <AppBarButton
                x:Uid="SaveLocalButton"
                Click="SaveLocal_Click"
                Icon="SaveLocal" />
        </CommandBar>
        <RichEditBox
            x:Name="Editor"
            Grid.Row="1"
            KeyDown="Editor_KeyDown"
            KeyUp="Editor_KeyUp" />
    </Grid>
</UserControl>
