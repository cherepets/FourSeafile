<Page
    x:Class="FourSeafile.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:uc="using:FourSeafile.UserControls"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" />
            <ColumnDefinition x:Name="RightColumn" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="SplitPane">
            <Grid.RenderTransform>
                <CompositeTransform />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListViewItem Tapped="Burger_Tapped">
                <StackPanel Margin="-12,0" Orientation="Horizontal">
                    <FontIcon
                        Width="50"
                        Height="48"
                        FontFamily="Segoe MDL2 Assets"
                        Glyph="" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="FOURSEAFILE" />
                </StackPanel>
            </ListViewItem>
            <uc:UserInfo Grid.Row="1" DataContext="{Binding UserInfo}" />
            <uc:Progress
                x:Name="Progress"
                Grid.Row="2"
                DataContext="{Binding Progress}" />
            <ListViewItem Grid.Row="3" Tapped="Logout_Tapped">
                <StackPanel Margin="-12,0" Orientation="Horizontal">
                    <FontIcon
                        Width="50"
                        Height="48"
                        FontFamily="Segoe MDL2 Assets"
                        Glyph="" />
                    <TextBlock x:Uid="LogoutBlock" VerticalAlignment="Center" />
                </StackPanel>
            </ListViewItem>
        </Grid>
        <Grid
            x:Name="SplitContent"
            Grid.Column="1"
            Margin="16,0,0,0"
            DataContext="{Binding FileBrowser}">
            <Grid.RenderTransform>
                <CompositeTransform />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <uc:FileBrowser Grid.Row="1" Grid.ColumnSpan="2" />
            <AppBarButton
                x:Name="CompactBurger"
                Width="50"
                Height="50"
                Click="CompactBurger_Click"
                IsCompact="True">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" />
                </AppBarButton.Icon>
            </AppBarButton>
            <uc:AddressBar
                Grid.Column="1"
                Address="{Binding Address}"
                RootRequested="AddressBar_RootRequested"
                UserInput="AddressBar_UserInput" />
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ViewStates">
                <VisualState x:Name="TwoPanes">
                    <VisualState.Setters>
                        <Setter Target="CompactBurger.Visibility" Value="Collapsed" />
                        <Setter Target="LeftColumn.Width" Value="Auto" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="TwoPanesCompact">
                    <VisualState.Setters>
                        <Setter Target="CompactBurger.Visibility" Value="Collapsed" />
                        <Setter Target="LeftColumn.Width" Value="50" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="LeftPane">
                    <VisualState.Setters>
                        <Setter Target="RightColumn.Width" Value="0" />
                        <Setter Target="SplitContent.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SplitPane" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)">
                            <LinearDoubleKeyFrame KeyTime="0" Value="-360" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="RightPane">
                    <VisualState.Setters>
                        <Setter Target="LeftColumn.Width" Value="0" />
                        <Setter Target="SplitPane.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SplitContent" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)">
                            <LinearDoubleKeyFrame KeyTime="0" Value="1000" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
