<Page
    x:Class="FourSeafile.Pages.AuthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:uc="using:FourSeafile.UserControls"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True"
    KeyDown="Page_KeyDown">
    <Grid>
        <StackPanel
            Width="320"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <StackPanel Margin="12" Spacing="4">
                <TextBlock x:Uid="HostBlock" />
                <TextBox x:Name="HostBox" Text="https://" />
            </StackPanel>
            <StackPanel Margin="12" Spacing="4">
                <TextBlock x:Uid="LoginBlock" />
                <TextBox x:Name="LoginBox" />
            </StackPanel>
            <StackPanel Margin="12" Spacing="4">
                <TextBlock x:Uid="PasswordBlock" />
                <PasswordBox x:Name="PasswordBox" />
            </StackPanel>
            <CheckBox
                x:Name="WindowsHelloBox"
                Margin="12"
                Content="Windows Hello"
                IsChecked="True" />
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="LoginButton"
                    x:Uid="LoginButton"
                    Grid.Column="0"
                    Click="LoginButton_Click" />
                <HyperlinkButton
                    x:Uid="SignUpButton"
                    Grid.Column="1"
                    Margin="12,0"
                    Click="HyperlinkButton_Click" />
                <Button
                    x:Name="DemoButton"
                    x:Uid="DemoButton"
                    Grid.Column="2"
                    Click="DemoButton_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</Page>
