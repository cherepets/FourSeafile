<UserControl
    x:Class="FourSeafile.UserControls.UserInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FourToolkit.Charts">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Ellipse
            Width="38"
            Height="38"
            Margin="6">
            <Ellipse.Fill>
                <ImageBrush ImageSource="{Binding Avatar}" />
            </Ellipse.Fill>
        </Ellipse>
        <TextBlock
            Grid.Column="1"
            MaxWidth="310"
            Margin="0,12,12,12"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Text="{Binding Nickname}"
            TextTrimming="CharacterEllipsis" />
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Width="100"
            Height="100"
            Margin="12">
            <c:DoughnutChart ItemsSource="{Binding UsageData}">
                <c:DoughnutChart.ItemTemplate>
                    <DataTemplate>
                        <c:DoughnutChartItem Color="{Binding Color}" Value="{Binding Part}" />
                    </DataTemplate>
                </c:DoughnutChart.ItemTemplate>
            </c:DoughnutChart>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    Foreground="{ThemeResource SystemControlBackgroundAccentBrush}"
                    Text="{Binding UsedSpace}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                    Text="{Binding TotalSpace}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
