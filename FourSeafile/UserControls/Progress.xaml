<UserControl
    x:Class="FourSeafile.UserControls.Progress"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:FourSeafile.UserControls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid
            Height="50"
            VerticalAlignment="Bottom"
            RenderTransformOrigin="0,0">
            <Grid.RenderTransform>
                <RotateTransform Angle="-90" />
            </Grid.RenderTransform>
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="Bold"
                Text="{Binding Stats}" />
        </Grid>
        <uc:GridView
            Grid.Column="1"
            DesiredItemSize="720"
            ItemsSource="{Binding NetworkOperations}">
            <uc:GridView.ItemsPanel>
                <DataTemplate>
                    <StackPanel />
                </DataTemplate>
            </uc:GridView.ItemsPanel>
            <uc:GridView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="12">
                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Maximum="{Binding Total}" Value="{Binding Value}" />
                    </StackPanel>
                </DataTemplate>
            </uc:GridView.ItemTemplate>
        </uc:GridView>
    </Grid>
</UserControl>
